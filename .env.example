# Variables d'environnement — copier les valeurs utiles dans .env.development.local / .env.test.local.
# Chaque plan complète ce fichier. Ne jamais y mettre de vraie valeur secrète.

# --- Base de données (plan 02) ---
# Local : Postgres Docker (npm run db:up). Vercel : injectée par l'intégration Neon (poolée).
# .env.development.local → base saisonnier ; .env.test.local → base saisonnier_test
DATABASE_URL=postgres://saisonnier@localhost:5432/saisonnier
# Connexion directe sans pooler, utilisée par les migrations (injectée par Neon, inutile en local).
# DATABASE_URL_UNPOOLED=

# --- Authentification (plan 03) ---
# Secret propre à chaque environnement : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'application. Local : http://localhost:3000 (http://localhost:3100 pour l'E2E).
# Vercel : https://saisonnier.vercel.app ; les previews s'y ajoutent via VERCEL_URL et VERCEL_BRANCH_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Emails (plan 03) ---
# Absente en local : les emails s'affichent dans la console, liens compris.
# RESEND_API_KEY=
# Adresse d'expédition. Sans domaine vérifié chez Resend, onboarding@resend.dev
# n'envoie qu'à l'adresse du compte Resend.
EMAIL_FROM=onboarding@resend.dev
# Boîte du fondateur, destinataire des notifications du service.
ADMIN_NOTIFICATION_EMAIL=fondateur@example.com
# Sans clé Resend, copie de chaque email (un fichier JSON) dans ce dossier ; l'E2E y lit les
# emails envoyés (.e2e-outbox, ignoré par git). Inutile ailleurs.
# EMAIL_OUTBOX_DIR=

# --- Documents des candidats (plan 10) ---
# vercel-blob (défaut) : store privé « saisonnier-documents », connecté au projet Vercel.
# local : fichiers écrits dans .storage/ (ignoré par git) ; c'est le choix de l'E2E et de la CI.
STORAGE_DRIVER=vercel-blob
# Injecté par Vercel ; en local : vercel env pull .env.local
# BLOB_READ_WRITE_TOKEN=

# --- Cycle de vie des annonces (plan 16) ---
# Secret de la route /api/cron/quotidien : Vercel Cron l'envoie dans « Authorization: Bearer … ».
# Propre à chaque environnement : openssl rand -base64 32
CRON_SECRET=
# Signature des liens « Votre annonce est-elle toujours valable ? » : openssl rand -base64 32
VALIDITY_TOKEN_SECRET=
